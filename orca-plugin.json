{
  "manifestVersion": 2,
  "id": "command-code-usage",
  "name": "Command Code Usage",
  "version": "0.6.2",
  "description": "Plan, limits and credits from the Command Code API, plus token and cost usage from local Command Code sessions.",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "command-code-usage",
        "title": "Command Code Usage",
        "icon": "bar-chart-3",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "statusBarItems": [
      {
        "id": "command-code-today",
        "text": "CC —",
        "icon": "terminal",
        "tone": "neutral",
        "tooltip": "Command Code usage today",
        "command": "command-code-usage.show-summary"
      }
    ],
    "commands": [
      {
        "id": "command-code-usage.show-summary",
        "title": "Command Code Usage: open panel"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "secrets:own"
    },
    {
      "kind": "workspace:read"
    }
  ]
}
